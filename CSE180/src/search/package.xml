<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>search</name>
  <version>0.0.0</version>
  <description>Final project: search the warehouse map for people and report where they are.</description>
  <maintainer email="root@todo.todo">root</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Only what the stage 2 skeleton uses. sensor_msgs, cv_bridge / vision_msgs,
       tf2, tf2_ros, tf2_geometry_msgs and nav_msgs are added in the stage that
       actually uses them. -->
  <depend>rclcpp</depend>
  <depend>navigation</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
